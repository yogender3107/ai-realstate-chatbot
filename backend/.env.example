# Recommended for free-tier testing with Groq:
AI_PROVIDER="groq"
AI_API_KEY="YOUR_GROQ_API_KEY"
AI_MODEL="openai/gpt-oss-20b"
# Groq OpenAI-compatible endpoint; leave as-is for Groq.
AI_BASE_URL="https://api.groq.com/openai/v1"

# For OpenAI instead, set AI_PROVIDER="openai", AI_API_KEY to your OpenAI key,
# AI_MODEL="gpt-4.1-mini", and remove/comment AI_BASE_URL.

DATABASE_URL="postgresql://postgres:password@localhost:5432/realState?schema=public"
PORT="4000"
# AWS_REGION="ap-south-1"
# DB_SECRET_ARN=""
